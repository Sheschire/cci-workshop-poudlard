# =============================================================================
# Dockerwarts N°1 — environment file
# -----------------------------------------------------------------------------
# Copy to `.env` and adapt. `.env` is git-ignored (no secret must ever be
# committed). Passwords are NOT stored here: they live in Docker secrets,
# generated by `scripts/init-secrets.sh` (see CDC annexe A).
#
#   cp .env.example .env
#
# Every variable below is consumed either by the Makefile, by
# `scripts/deploy.sh` (which does `set -a; source .env`) before
# `docker stack deploy`, or by the Ansible inventory.
# =============================================================================

# --- Naming and entry point --------------------------------------------------
# Base domain of the platform. Every UI is exposed as <service>.$DOMAIN through
# the VIP. Do NOT use `.local` (reserved for mDNS) — see CDC §3.1.
DOMAIN=dockerwarts.lan

# Floating VIP carried by Keepalived (VRRP). Single entry point of the cluster.
VIP=192.168.56.10

# --- Cluster nodes -----------------------------------------------------------
NODE1_IP=192.168.56.11
NODE2_IP=192.168.56.12
NODE3_IP=192.168.56.13

# Subnet holding the three nodes. Used by the host firewall to scope the
# cluster ports (Swarm, VXLAN, NFS, VRRP, registry).
CLUSTER_CIDR=192.168.56.0/24

# Administration workstation (the VirtualBox host). Used for the SSH rule and
# for the Traefik `admin-allowlist` middleware protecting Prometheus,
# Alertmanager, Kibana, the Traefik dashboard and the MinIO console.
ADMIN_CIDR=192.168.56.1/32

# --- Sizing ------------------------------------------------------------------
# full : 6 GB RAM per node, ES heap 1g,  Cassandra heap 1G
# lite : 4 GB RAM per node, ES heap 512m, Cassandra heap 768M
PROFILE=full

# Per-VM sizing handed to Vagrant (`make vms`).
NODE_MEM=6144
NODE_CPU=4

# --- Networking --------------------------------------------------------------
# IPsec encryption of the `data` overlay network. `true` is the default and the
# documented posture (ADR-0007 relies on it to keep the Elasticsearch HTTP API
# in clear text). Set to `false` only to measure its cost — CDC §5.4.
DATA_NETWORK_ENCRYPTED=true

# --- Shared storage ----------------------------------------------------------
# NFS server exporting /srv/nfs/{glpi,backup-metrics}. Assumed SPOF (ADR-0006).
# Changing this value + `make deploy-apps` is the NFS failover procedure.
NFS_SERVER=192.168.56.11

# --- Internal registry -------------------------------------------------------
# Holds the four home-made images. Declared as an insecure registry in
# daemon.json by Ansible and only reachable from CLUSTER_CIDR (CDC §10.2).
REGISTRY=192.168.56.13:5000

# Tag applied to the home-made images by `make build`.
IMAGE_TAG=1.0.0

# --- Misc --------------------------------------------------------------------
TZ=Europe/Paris

# --- Off-site backup mirror (optional) ---------------------------------------
# When OFFSITE_S3_ENDPOINT is empty the hourly `offsite-mirror` job exits 0
# without doing anything. Credentials go to the Docker secrets
# dw_offsite_s3_key / dw_offsite_s3_secret.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=

# --- Extra alert notifications (optional) ------------------------------------
# When SMTP_HOST is empty, Alertmanager only routes to the `glpi` receiver.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=alertmanager@dockerwarts.lan
ALERT_EMAIL_TO=

# --- Demo load (stacks/demo.yml, optional) -----------------------------------
# Events per second and number of simulated sensors. The defaults come from
# CDC §7.8; raising them is a way to load-test, not a way to make the demo
# "better" — the point of this producer is continuity, not throughput.
DEMO_RATE=20
DEMO_SENSORS=50
