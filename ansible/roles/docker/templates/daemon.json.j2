{
  "//": "Managed by Ansible — dockerwarts. Do not edit by hand.",

  "// log-driver": "json-file with rotation: Fluent Bit tails these files (CDC §7.4). Never use the fluentd driver here — a Fluent Bit outage would block the containers.",
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3",
    "labels": "com.docker.swarm.service.name,com.docker.swarm.node.id,com.docker.stack.namespace"
  },

  "// metrics-addr": "Docker Engine metrics, scraped by Prometheus over the cluster network only.",
  "metrics-addr": "{{ cluster_ip }}:9323",

  "// insecure-registries": "Internal registry, plain HTTP over the filtered lab network (CDC §10.2).",
  "insecure-registries": ["{{ dw_registry_host }}"],

  "// default-address-pool": "Keeps Docker-managed bridges and overlays inside a predictable range, which the DOCKER-USER rules rely on.",
  "default-address-pools": [
    {"base": "172.20.0.0/16", "size": 24},
    {"base": "{{ dw_swarm_default_addr_pool }}", "size": {{ dw_swarm_default_addr_pool_subnet_size }}}
  ],

  "// live-restore": "Not compatible with Swarm mode; containers are restarted by Swarm anyway.",
  "live-restore": false,

  "// userland-proxy": "Disabled so that published host-mode ports keep the real client IP path simple (ADR-0003) and DOCKER-USER sees the traffic.",
  "userland-proxy": false,

  "// no-new-privileges": "Daemon-wide default; each service also sets it explicitly (CDC §6.4).",
  "no-new-privileges": false,

  "default-ulimits": {
    "nofile": {"Name": "nofile", "Hard": 262144, "Soft": 262144},
    "memlock": {"Name": "memlock", "Hard": -1, "Soft": -1}
  },

  "storage-driver": "overlay2",
  "features": {"buildkit": true}
}
