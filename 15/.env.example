# Azure AD / Microsoft Identity Platform Configuration
# Get these values from Azure Portal: https://portal.azure.com
# Azure Active Directory → App registrations → Your App

# Application (client) ID
AZURE_CLIENT_ID=your-client-id-here

# Client secret (from Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID - use "common" for multi-tenant or personal accounts
AZURE_TENANT_ID=common

# OAuth redirect URI (must match Azure AD configuration)
REDIRECT_URI=http://localhost:3001/auth/callback

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:3000

# Backend port
PORT=3001

# Session secret for cookie signing
SESSION_SECRET=your-random-session-secret-here
