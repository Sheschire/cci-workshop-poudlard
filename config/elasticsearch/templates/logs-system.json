{
  "_comment": "Index template for `logs-system`: journald units (docker, keepalived, ssh) collected by the Fluent Bit systemd input.",
  "index_patterns": ["logs-system*"],
  "data_stream": {},
  "priority": 200,
  "composed_of": ["dockerwarts-logs-common"],
  "template": {
    "mappings": {
      "properties": {
        "SYSTEMD_UNIT": { "type": "keyword" },
        "PRIORITY":     { "type": "short" },
        "_HOSTNAME":    { "type": "keyword" },
        "_PID":         { "type": "long" },
        "SYSLOG_IDENTIFIER": { "type": "keyword" }
      }
    }
  },
  "_meta": { "managed_by": "scripts/es-init.sh" }
}
