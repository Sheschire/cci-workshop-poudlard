    },
    {
      "type": "row",
      "title": "Contenu des journaux",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Volume de logs par service",
      "description": "Top 10 des services les plus bavards.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "dw-es-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "dw-es-logs"
          },
          "query": "*",
          "refId": "A",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service_name",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Erreurs par service",
      "description": "Repose sur le champ `log_level` normalisé par le filtre Lua de Fluent Bit : sans lui, chaque service écrirait sa sévérité différemment et ce panneau serait impossible.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "dw-es-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "dw-es-logs"
          },
          "query": "log_level:(error OR fatal)",
          "refId": "A",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service_name",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 15
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 11
    },
