{
  "uid": "dw-backup",
  "title": "10 — Sauvegardes",
  "description": "État des jobs de sauvegarde et du dépôt. C'est le dashboard qui transforme « nous avons des sauvegardes » en « nous savons qu'elles fonctionnent ».",
  "tags": [
    "dockerwarts",
    "backup"
  ],
  "timezone": "Europe/Paris",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
