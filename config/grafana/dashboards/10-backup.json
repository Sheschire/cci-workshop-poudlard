    {
      "type": "timeseries",
      "title": "Âge des sauvegardes",
      "description": "Chaque dent de scie est une exécution réussie. Une courbe qui monte sans redescendre est un job qui a cessé de tourner.",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "(time() - backup_last_success_timestamp) / 3600",
          "legendFormat": "{{job}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 17
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 9
    },
