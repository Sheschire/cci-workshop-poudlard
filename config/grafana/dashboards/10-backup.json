      "type": "stat",
      "title": "Jobs suivis",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "count(backup_last_success_timestamp)",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
