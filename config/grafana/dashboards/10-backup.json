    {
      "type": "table",
      "title": "Âge, durée, taille et état par job",
      "description": "État 0 = succès. Toute autre valeur déclenche BackupFailed.",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "time() - backup_last_success_timestamp",
          "legendFormat": "{{job}} âge (s)",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "backup_last_duration_seconds",
          "legendFormat": "{{job}} durée (s)",
          "refId": "B",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "backup_last_size_bytes",
          "legendFormat": "{{job}} taille",
          "refId": "C",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "backup_last_status",
          "legendFormat": "{{job}} état",
          "refId": "D",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "instant": true
        }
