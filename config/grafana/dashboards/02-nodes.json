      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "avg(100 - (avg by (node) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\",node=~\"$node\"}[5m])) * 100))",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 5,
        "x": 0,
