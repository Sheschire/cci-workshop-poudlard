    {
      "type": "timeseries",
      "title": "Réponses 401 / 403 / 404 / 429",
      "description": "403 en hausse = CrowdSec bannit ou l'allowlist rejette. 404 en rafale = énumération de chemins. 429 = rate-limit Traefik atteint.",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=\"401\"}[5m]))",
          "legendFormat": "401 non authentifié",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=\"403\"}[5m]))",
          "legendFormat": "403 interdit (bannissement / allowlist)",
          "refId": "B",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=\"404\"}[5m]))",
          "legendFormat": "404 introuvable (scan)",
          "refId": "C",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=\"429\"}[5m]))",
          "legendFormat": "429 rate-limit",
          "refId": "D",
          "editorMode": "code",
          "range": true
        }
      ],
