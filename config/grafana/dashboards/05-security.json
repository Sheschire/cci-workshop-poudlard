        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum by (name) (rate(cs_bucket_overflowed_total[15m]))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
