    {
      "type": "stat",
      "title": "Décisions actives",
      "description": "IP actuellement bannies. Une valeur non nulle est normale sur une plateforme exposée.",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(cs_active_decisions) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
