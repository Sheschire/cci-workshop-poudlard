    {
      "type": "logs",
      "title": "Authentifications SSH (logs-system)",
      "description": "Tentatives SSH vues par le journal systemd. fail2ban bannit localement, CrowdSec au niveau du cluster.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "dw-es-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "dw-es-logs"
          },
          "query": "SYSTEMD_UNIT:\"ssh.service\" AND (message:\"Failed\" OR message:\"Accepted\")",
          "refId": "A",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "500"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "gridPos": {
        "w": 24,
        "h": 10,
        "x": 0,
        "y": 24
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 12
    },
