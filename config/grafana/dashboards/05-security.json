    {
      "type": "stat",
      "title": "LAPI",
      "description": "LAPI absente = les décisions ne se mettent plus à jour. La protection RESTE active : le bouncer Traefik est en mode `stream` avec un cache local.",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "up{job=\"crowdsec\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "w": 6,
