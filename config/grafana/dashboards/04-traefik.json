    {
      "type": "stat",
      "title": "Requêtes/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{entrypoint=\"websecure\"}[5m]))",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Taux de 5xx",
      "description": "`clamp_min` sur le dénominateur : sans lui, un trafic nul produirait NaN et le panneau resterait vide.",
      "datasource": {
        "type": "prometheus",
        "uid": "dw-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dw-prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"5..\",entrypoint=\"websecure\"}[5m])) / clamp_min(sum(rate(traefik_entrypoint_requests_total{entrypoint=\"websecure\"}[5m])), 0.001) * 100",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3
    },
