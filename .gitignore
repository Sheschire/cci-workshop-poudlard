# Local environment & secrets — never commit
.env
secrets/
certs/
*.pem
*.key
*.crt
!config/**/*.example

# Vagrant / Ansible
.vagrant/
*.retry
ansible/inventory/hosts.yml

# Tooling
.venv/
__pycache__/
*.pyc
node_modules/
.DS_Store
*.log

# Ansible controller artefacts
.ansible/
ansible/inventory/hosts.yml

# Test and drill reports (only the ones copied into docs/ are committed)
reports/

# Rendered configuration (produced by scripts/lib/render.sh at deploy time)
.rendered/
